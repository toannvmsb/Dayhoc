{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoldenErrorCase",
  "type": "object",
  "required": [
    "error_case_id",
    "question_case_id",
    "skill_id",
    "problem_type",
    "student_wrong_response_pattern",
    "error_signature",
    "expected_gap_type",
    "root_cause_class",
    "mastery_update_expectation",
    "diagnostic_followup"
  ],
  "properties": {
    "error_case_id": {
      "type": "string"
    },
    "question_case_id": {
      "type": "string"
    },
    "grade_context": {
      "enum": [
        4,
        7
      ]
    },
    "skill_id": {
      "type": "string"
    },
    "problem_type": {
      "type": "string"
    },
    "knowledge_level": {
      "type": "string"
    },
    "thinking_level": {
      "type": "string"
    },
    "student_wrong_response_pattern": {
      "type": "string"
    },
    "error_signature": {
      "type": "string"
    },
    "expected_gap_type": {
      "enum": [
        "concept_gap",
        "prerequisite_gap",
        "method_gap",
        "recognition_gap",
        "application_gap",
        "reasoning_gap",
        "procedural_gap",
        "retention_gap",
        "careless_error",
        "reading_error",
        "presentation_error"
      ]
    },
    "root_cause_class": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "mastery_update_expectation": {
      "type": "string"
    },
    "diagnostic_followup": {
      "type": "string"
    },
    "remediation_prescription": {
      "type": "object"
    }
  }
}