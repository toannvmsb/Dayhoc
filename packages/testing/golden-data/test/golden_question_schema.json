{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GoldenQuestion",
  "type": "object",
  "required": [
    "case_id",
    "grade_context",
    "curriculum_origin",
    "skill_id",
    "problem_type",
    "knowledge_level",
    "thinking_level",
    "prompt",
    "expected_answer",
    "expected_error_diagnosis"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "grade_context": {
      "enum": [
        4,
        7
      ]
    },
    "curriculum_origin": {
      "type": "string"
    },
    "skill_id": {
      "type": "string"
    },
    "problem_type": {
      "type": "string"
    },
    "knowledge_level": {
      "enum": [
        "K0",
        "K1",
        "K2",
        "K3",
        "K4",
        "K5"
      ]
    },
    "thinking_level": {
      "enum": [
        "T1",
        "T2",
        "T3",
        "T4",
        "T5"
      ]
    },
    "prompt": {
      "type": "string"
    },
    "expected_answer": {
      "type": "string"
    },
    "solution_outline": {
      "type": "string"
    },
    "expected_error_diagnosis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_basis": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    }
  }
}