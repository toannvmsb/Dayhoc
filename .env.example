# AI Parent Learning Copilot — environment template.
# Copy to `.env` and fill real values. NEVER commit `.env`.

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parent_copilot
# Staging Supabase Postgres (doc 67). Session pooler URI, port 5432, real
# password (no <…> / [YOUR-PASSWORD] placeholders). `scripts/staging.mjs` runs
# migrations + integration tests against this without touching DATABASE_URL.
STAGING_DATABASE_URL=
# Pilot Supabase Postgres (doc 70) — the deployed pilot's own project, separate
# from staging. Session pooler URI, port 5432, real password. Used ONLY by
# `node scripts/pilot-db.mjs -- <cmd>` (e.g. `-- npm run db:migrate`) so the
# password stays out of shell history. Never becomes the app's DATABASE_URL here.
PILOT_DATABASE_URL=

# --- Worksheet generation queue (doc 67 §D2) ---
# `durable` → persist jobs to Postgres (restart-safe, multi-worker); a
# deployment then runs a WorksheetJobWorker (createWorksheetJobWorker).
# unset / anything else → the in-process queue.
WORKSHEET_QUEUE=

# --- Cache / Queue ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=parent-copilot-uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- Auth (production) — Supabase (M43) ---
# resolveAuthAdapter() picks SupabaseAuthAdapter when URL + JWT secret are set.
# DZ_DEV_AUTH is IGNORED when NODE_ENV=production (fails closed — see M42 test).
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
# Local/dev only: browser session without a real IdP. NEVER set in production.
DZ_DEV_AUTH=

# --- Upload storage (M4) ---
# Local filesystem when unset; Supabase Storage when all three below are set.
DZ_UPLOAD_DIR=./.dz-uploads
SUPABASE_STORAGE_BUCKET=

# --- Document vision (M4) ---
# Mock adapter always, UNLESS DZ_LIVE_VISION=1 AND OPENAI_API_KEY set. No upload
# ever spends money by accident.
DZ_LIVE_VISION=

# --- AI providers (replaceable adapters — see @copilot/ai) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
VISION_PROVIDER=anthropic
# USD per 1M tokens — used for cost tracking (provisional; set per real pricing)
LLM_PRICE_INPUT_PER_MILLION=3
LLM_PRICE_OUTPUT_PER_MILLION=15
AI_MONTHLY_BUDGET_USD=

# --- Live exercise generation (Luna / OpenAI adapter — doc 14 C5, doc 18) ---
# resolveLunaApiKey() reads OPENAI_API_KEY fresh from the environment and stores
# it on nothing. Leave BLANK here; provide it only via a real shell env var or a
# secret manager — NEVER commit a real key, not even in a local .env you keep.
OPENAI_API_KEY=
# OFF (default) | SHADOW | LIVE  — LIVE delivery to a child is not activated yet.
AI_GENERATION_MODE=OFF
AI_GENERATION_DEFAULT_PROVIDER=openai
AI_GENERATION_DEFAULT_MODEL=gpt-5.6-luna
AI_GENERATION_STRUCTURED_OUTPUT_MODE=JSON_OBJECT_FALLBACK
# Explicit opt-in for tests that spend real API budget (must be exactly "1").
RUN_LIVE_AI_BENCHMARK=
# Paid-benchmark spend guardrails (the run aborts before exceeding these).
LIVE_BENCHMARK_MAX_BATCHES=20
LIVE_BENCHMARK_MAX_COST_USD=5

# --- CONTROLLED INTERNAL LIVE (doc 69) -----------------------------------
# LIVE generation reaches a child ONLY when AI_GENERATION_MODE=LIVE AND the
# family's pseudonymous ref is in `internal_live_cohort` (add via
# POST /admin/internal-live/cohort). Nothing else is public.
#
# Server-side kill switch — "true" halts ALL new paid AI calls with no redeploy.
# (There is also a DB switch: POST /admin/internal-live/kill-switch, and the
# safety monitor flips the DB one automatically on any CRITICAL condition.)
AI_GENERATION_KILL_SWITCH=false
# Operational daily caps for the internal-live cohort (NOT benchmark budgets;
# never auto-raised). Budget exhaustion degrades LIVE → SHADOW, it never errors.
INTERNAL_LIVE_GEN_DAILY_CAP_USD=2.00
INTERNAL_LIVE_XCHECK_DAILY_CAP_USD=0.50
# Wave-1 QA sampling — 1-in-N delivered LIVE worksheets, SHORT retention (days,
# capped at 30), reads are access-logged, excluded from analytics.
INTERNAL_LIVE_QA_SAMPLE_ONE_IN=5
INTERNAL_LIVE_QA_RETENTION_DAYS=7
AI_CROSSCHECK_MODE=OFF

# --- SMALL FAMILY PILOT (doc 70) ----------------------------------------
# A pilot family is a row in `internal_live_cohort` with kind='pilot' +
# consent_required=true (add via POST /admin/pilot/cohort). LIVE content is
# NOT served to a pilot child until a guardian consent row is on file
# (POST /children/:id/pilot/consent). Same cohort gate + kill switch + caps
# as internal LIVE — nothing here widens who can be served.
#
# QA sampling for pilot families: event-triggered on any degraded path (safe
# substitution / optional omission / crosscheck-uncertain / review / high
# retry), plus this base rate at random (0.05–0.10). Unset → falls back to
# INTERNAL_LIVE_QA_SAMPLE_ONE_IN. Retention stays INTERNAL_LIVE_QA_RETENTION_DAYS.
PILOT_QA_SAMPLE_RATE=0.08
# safety-scan cron look-back window (minutes); run the cron every ~10 min.
PILOT_SAFETY_WINDOW_MIN=60

# --- Pilot API host (Next.js) ---
# The pilot needs a persistent, externally-reachable HTTPS host + a separate
# long-lived worker process + two crons. See docs/implementation/70 §Deploy.
PORT=3100

# --- Observability ---
LOG_LEVEL=info
AI_COST_TRACKING=true

# --- App ---
NODE_ENV=development
