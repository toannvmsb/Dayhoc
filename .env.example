# AI Parent Learning Copilot — environment template.
# Copy to `.env` and fill real values. NEVER commit `.env`.

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parent_copilot

# --- Cache / Queue ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=parent-copilot-uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- AI providers (replaceable adapters) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
VISION_PROVIDER=anthropic

# --- Observability ---
LOG_LEVEL=info
AI_COST_TRACKING=true

# --- App ---
NODE_ENV=development
