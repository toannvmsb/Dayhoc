# AI Parent Learning Copilot — environment template.
# Copy to `.env` and fill real values. NEVER commit `.env`.

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/parent_copilot

# --- Cache / Queue ---
REDIS_URL=redis://localhost:6379

# --- Object storage (S3-compatible) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=parent-copilot-uploads
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# --- AI providers (replaceable adapters — see @copilot/ai) ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
VISION_PROVIDER=anthropic
# USD per 1M tokens — used for cost tracking (provisional; set per real pricing)
LLM_PRICE_INPUT_PER_MILLION=3
LLM_PRICE_OUTPUT_PER_MILLION=15
AI_MONTHLY_BUDGET_USD=

# --- Live exercise generation (Luna / OpenAI adapter — doc 14 C5, doc 18) ---
# resolveLunaApiKey() reads OPENAI_API_KEY fresh from the environment and stores
# it on nothing. Leave BLANK here; provide it only via a real shell env var or a
# secret manager — NEVER commit a real key, not even in a local .env you keep.
OPENAI_API_KEY=
# OFF (default) | SHADOW | LIVE  — LIVE delivery to a child is not activated yet.
AI_GENERATION_MODE=OFF
AI_GENERATION_DEFAULT_PROVIDER=openai
AI_GENERATION_DEFAULT_MODEL=gpt-5.6-luna
AI_GENERATION_STRUCTURED_OUTPUT_MODE=JSON_OBJECT_FALLBACK
# Explicit opt-in for tests that spend real API budget (must be exactly "1").
RUN_LIVE_AI_BENCHMARK=
# Paid-benchmark spend guardrails (the run aborts before exceeding these).
LIVE_BENCHMARK_MAX_BATCHES=20
LIVE_BENCHMARK_MAX_COST_USD=5

# --- Observability ---
LOG_LEVEL=info
AI_COST_TRACKING=true

# --- App ---
NODE_ENV=development
