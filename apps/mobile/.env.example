# DạyZi mobile — build/runtime config. Copy to `.env` (gitignored) or export
# these before `npx expo start` / `eas build`. See app.config.ts.

# dev | staging | production  (default: dev)
DZ_ENV=dev

# DEV only: your computer's LAN IP so a phone on the same Wi-Fi can reach the
# web app's /api/v1. Find it with `ipconfig` (IPv4 Address of the Wi-Fi card).
# Leave blank to use `localhost` (simulator only).
EXPO_PUBLIC_DEV_HOST=

# Full override for any channel (wins over DZ_ENV defaults). MUST be https for a
# production build.
#   staging default:    https://staging.dayzi.vn/api/v1
#   production default:  https://app.dayzi.vn/api/v1
EXPO_PUBLIC_API_BASE_URL=
